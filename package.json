{
  "name": "undead-tower",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "main": "desktop/main.cjs",
  "author": "Undead Tower",
  "description": "Undead Tower — 固定朝向、有限视角的低多边形第一人称射击游戏",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5175",
    "build": "tsc -b && vite build",
    "install:runtime": "node node_modules/electron/install.js",
    "desktop": "npm run install:runtime && npm run build && electron .",
    "dist:portable": "npm run install:runtime && node scripts/collect-notices.mjs && npm run build && electron-builder --config electron-builder.cjs --win portable --x64 --publish never && node scripts/portable-smoke-manifest.mjs",
    "test:portable": "node scripts/smoke-portable.mjs",
    "test:desktop:hidden": "node scripts/smoke-portable.mjs --desktop",
    "preview": "vite preview --host 127.0.0.1 --port 4175",
    "test": "vitest run",
    "test:e2e": "node scripts/run-e2e.mjs",
    "balance": "node scripts/evaluate-balance.mjs",
    "verify": "npm run test && npm run build && npm run test:e2e",
    "balance:rogue": "node scripts/evaluate-rogue.mjs",
    "test:rogue:replay": "node scripts/replay-rogue.mjs"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "^5.2.8",
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^6.1.0",
    "electron": "44.1.1",
    "electron-builder": "26.15.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
