{
  "name": "undead-tower",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Undead Tower — 固定朝向、有限视角的低多边形第一人称射击游戏",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5175",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4175",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "balance": "node scripts/evaluate-balance.mjs",
    "verify": "npm run test && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "^5.2.8",
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^6.1.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
